# Copy to .env and fill in (never commit .env)
ENTRA_TENANT_ID=<tenant-guid>
SNOWFLAKE_APP_ID=<snowflake-resource-app-id>
ENTRA_CLIENT_ID=<client-app-id>
ENTRA_CLIENT_SECRET=<client-secret>
MCP_URL=https://<org>-<account>.snowflakecomputing.com/api/v2/databases/MCP_DEMO/schemas/MCP/mcp-servers/RESEARCH
SF_ROLE=MCP_USER
# for scripts/mcp_as_user.py
MCP_TOKEN=<user-access-token>
