# Copy to icedock/.env (never commit). scripts/entra_finish.sh writes this for you.
ENTRA_TENANT_ID=<tenant-guid>
ENTRA_CLIENT_ID=<client-app-id>            # web app, redirects: /auth/callback and /api/integrations/callback
ENTRA_CLIENT_SECRET=<client-secret>
SNOWFLAKE_APP_ID=<snowflake-resource-app-id>  # app that exposes api://<id>/session:role:<ROLE>
SNOWFLAKE_ACCOUNT_URL=https://<org>-<account>.snowflakecomputing.com
SF_ROLE=LDC_MCP_USER
MCP_URL=https://<org>-<account>.snowflakecomputing.com/api/v2/databases/LDC_DEMO/schemas/MCP/mcp-servers/RESEARCH
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=<random 32+ chars>
